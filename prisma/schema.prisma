// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String           @id @default(cuid())
  email                        String           @unique
  passwordHash                 String           @map("password_hash")
  name                         String?
  stripeCustomerId             String?          @map("stripe_customer_id")
  subscriptionStatus           String?          @map("subscription_status")
  subscriptionCurrentPeriodEnd DateTime?        @map("subscription_current_period_end")
  createdAt                    DateTime         @default(now()) @map("created_at")
  emailVerified                DateTime?        @map("email_verified")
  emailVerificationToken       String?          @unique @map("email_verification_token")
  emailVerificationExpires     DateTime?        @map("email_verification_expires")
  passwordResetToken           String?          @unique @map("password_reset_token")
  passwordResetExpires         DateTime?        @map("password_reset_expires")
  // When a human last chose a password for this account. NULL means nobody
  // has: the account was created by a guest plugin purchase (see
  // lib/plugin-purchase-grant.ts) and the buyer has not set one yet. The
  // receipt email and the login page key off this to say "set a password"
  // rather than "sign in". Register and reset-password both stamp it.
  passwordSetAt                DateTime?        @map("password_set_at")
  // A requested-but-unconfirmed email address, plus its one-shot token. The
  // account keeps its current `email` until the owner opens the link we send
  // to `pendingEmail`, so a mistyped new address changes nothing.
  pendingEmail                 String?          @map("pending_email")
  emailChangeToken             String?          @unique @map("email_change_token")
  emailChangeExpires           DateTime?        @map("email_change_expires")
  // Marketing / newsletter opt-in (Mailchimp exports). Default true at signup when checkbox left on.
  emailMarketingOptIn          Boolean          @default(true) @map("email_marketing_opt_in")
  // "drft v1.1.3 - Out Now" release notices. A narrower opt-out layered on
  // top of emailMarketingOptIn, not independent of it: release emails go only
  // to owners with BOTH flags on (see lib/release-recipients.ts), so turning
  // off marketing email suppresses these too, while this flag alone lets
  // someone keep the newsletter and drop version notices. Neither flag ever
  // suppresses a receipt, a verification or a password reset — those are
  // transactional and are sent regardless of both.
  productUpdateOptIn           Boolean          @default(true) @map("product_update_opt_in")
  // First-touch attribution, snapshotted at signup. Mirrors the philosophy of
  // AffiliateReferral.commissionCents — a historical fact that later data
  // changes (or pruning of landing_events) must never rewrite.
  attributionVisitorId         String?          @map("attribution_visitor_id")
  attributionReferrerHost      String?          @map("attribution_referrer_host")
  attributionUtmSource         String?          @map("attribution_utm_source")
  attributionUtmCampaign       String?          @map("attribution_utm_campaign")
  attributionLandingPath       String?          @map("attribution_landing_path")
  savedSamples                 UserSample[]
  digHistory                   UserDigHistory[]
  events                       UserEvent[]
  purchases                    Purchase[]
  affiliate                    Affiliate?
  compCodesRedeemed            CompCode[]

  @@index([attributionVisitorId])
  @@map("users")
}

model Purchase {
  id                String              @id @default(cuid())
  userId            String              @map("user_id")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           String // e.g. "shft"
  stripeSessionId   String?             @unique @map("stripe_session_id")
  // The buyer's licence key. Minted on purchase; backfilled for purchases that
  // predate licensing. Never regenerated — a buyer may already have it typed
  // into the plugin, and rotating it would deactivate them silently.
  licenseKey        String?             @unique @map("license_key")
  createdAt         DateTime            @default(now()) @map("created_at")
  affiliateReferral AffiliateReferral?
  activations       LicenseActivation[]
  compCode          CompCode?

  @@unique([userId, product])
  @@index([userId])
  @@map("purchases")
}

model LicenseActivation {
  id            String    @id @default(cuid())
  purchaseId    String    @map("purchase_id")
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  // The whole hashed set. Valid while ANY one still matches locally; there is
  // deliberately no unique index, because "intersects" is not expressible as one.
  machineIds    String[]  @map("machine_ids")
  machineName   String?   @map("machine_name")
  platform      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  deactivatedAt DateTime? @map("deactivated_at")

  @@index([purchaseId])
  @@map("license_activations")
}

model CompCode {
  id               String    @id @default(cuid())
  // GIFT-XXXX-XXXX-XXXX — see lib/comp-code.ts. Distinct from licenseKey on
  // purpose: this is redeemed on the WEBSITE, never pasted into the plugin.
  code             String    @unique
  // What redeeming this code grants: "shft", "drft", or "bundle" (both).
  // Defaults to shft so codes minted before this column existed - all of
  // which were shft - keep granting exactly what they always did.
  product          String    @default("shft")
  // "code": typed in at /redeem by a signed-in account. "link": a gift link,
  // claimed at /gift/<code> with one tap and no account. See lib/gift-link.ts.
  kind             String    @default("code")
  note             String?
  // Gift links only: shown to the recipient above the Claim button.
  message          String?
  // Gift links only: sha256 of the claim token held by the browser that
  // claimed it (and carried in its private link). A claimed link with this
  // null was reopened by an admin: the next Claim rebinds it, same keys.
  claimTokenHash   String?   @unique @map("claim_token_hash")
  // The admin who generated it (from requireAdmin()'s session) — cheap audit
  // trail on a tool that hands out free product.
  createdByEmail   String?   @map("created_by_email")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  redeemedAt       DateTime? @map("redeemed_at")
  redeemedByUserId String?   @map("redeemed_by_user_id")
  redeemedByUser   User?     @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  // The Purchase this redemption produced. Nullable/SetNull rather than
  // Cascade: this row is the audit trail of "code X was redeemed by Y", which
  // should survive even if the purchase it produced is ever removed.
  purchaseId       String?   @unique @map("purchase_id")
  purchase         Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([redeemedByUserId])
  @@map("comp_codes")
}

// One row per (product, version) announcement blast. The unique constraint IS
// the safety mechanism: the row is claimed BEFORE the first email goes out, so
// a second attempt — a double-clicked button, a retried request, a redeploy —
// collides and refuses instead of mailing every customer twice. There is no
// unsending, so this errs hard toward refusing.
//
// sentEmails/failedEmails make a blast resumable at the recipient level: the
// admin UI sends in small batches and each batch skips addresses already in
// sentEmails, so a crash or a closed tab halfway through costs nothing and
// resuming never double-sends. Same String[] shape as LicenseActivation.
model ReleaseAnnouncement {
  id             String    @id @default(cuid())
  product        String
  version        String
  // Snapshotted at claim time rather than read from lib/products.ts at send
  // time: the changelog is edited between releases, and this row is the record
  // of what was ACTUALLY mailed, which must not change afterwards. Same
  // philosophy as AffiliateReferral.commissionCents.
  subject        String
  bodyHtml       String    @map("body_html")
  sentByEmail    String?   @map("sent_by_email")
  sentEmails     String[]  @map("sent_emails")
  failedEmails   String[]  @map("failed_emails")
  createdAt      DateTime  @default(now()) @map("created_at")
  // Null while a blast is mid-flight or was abandoned partway.
  completedAt    DateTime? @map("completed_at")

  @@unique([product, version])
  @@map("release_announcements")
}

// A one-off discount mailed to the people who already have an account - the
// "$10 off any plugin" thank-you at fltr's launch. One row per offer. Like
// ReleaseAnnouncement, it is claimed (inserted) BEFORE anything is created in
// Stripe or mailed, so a second press of Send cannot start a second offer:
// the unique slug refuses it.
//
// `cutoffAt` is the moment Send was first pressed. Only accounts created at or
// before it are offered a code, however long the send takes to finish, so an
// account made mid-send - or next week - never gets one.
model MemberOffer {
  id             String    @id @default(cuid())
  slug           String    @unique
  amountOffCents Int       @map("amount_off_cents")
  // The Stripe coupon every code in this offer points at. Set on claim.
  couponId       String?   @map("coupon_id")
  cutoffAt       DateTime  @map("cutoff_at")
  expiresAt      DateTime  @map("expires_at")
  // Snapshotted on claim, with placeholders for the per-person parts - the
  // record of what was actually mailed. See lib/email.ts.
  subject        String
  bodyHtml       String    @map("body_html")
  sentByEmail    String?   @map("sent_by_email")
  createdAt      DateTime  @default(now()) @map("created_at")
  // Null while a send is mid-flight or was stopped partway.
  completedAt    DateTime? @map("completed_at")

  codes     MemberOfferCode[]
  reminders MemberOfferReminder[]

  @@map("member_offers")
}

// One person's code in a MemberOffer. Written before the Stripe promotion code
// is created and before the email goes, so a batch that dies partway is
// resumed rather than repeated: the (offer, user) pair is unique, the code is
// derived from them (lib/member-offer-logic.ts), and Stripe is asked with an
// idempotency key - a retry lands on the same code every time.
//
// Also what the cart asks when a signed-in member has something in it: a sent,
// unexpired code here is applied without being typed.
model MemberOfferCode {
  id              String      @id @default(cuid())
  offerId         String      @map("offer_id")
  offer           MemberOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId          String      @map("user_id")
  // As it was when the code was made, for the admin's record of who was
  // mailed. The cart looks codes up by user id, never by address.
  email           String
  code            String      @unique
  promotionCodeId String?     @map("promotion_code_id")
  sentAt          DateTime?   @map("sent_at")
  // The last send that failed, for the admin screen. Cleared by a later
  // success.
  failedAt        DateTime?   @map("failed_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([offerId, userId])
  @@index([userId])
  @@map("member_offer_codes")
}

// A second email about a MemberOffer, to the people it was sent to who have
// neither used their code nor bought fltr since. One row per reminder, claimed
// (inserted) before anyone is mailed, like the offer itself: the unique slug
// refuses a second press of Send.
//
// Two emails are snapshotted, because there are two kinds of reader: someone
// who owns nothing can buy all three at the bundle price, and someone who owns
// one already cannot - the bundle is every plugin in one cart - so theirs is
// about fltr alone. See lib/offer-reminder-logic.ts.
model MemberOfferReminder {
  id            String      @id @default(cuid())
  offerId       String      @map("offer_id")
  offer         MemberOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  slug          String      @unique
  // What went to someone who owns none of the range.
  subject       String
  bodyHtml      String      @map("body_html")
  // What went to someone who owns something, but not fltr.
  ownerSubject  String      @map("owner_subject")
  ownerBodyHtml String      @map("owner_body_html")
  sentByEmail   String?     @map("sent_by_email")
  createdAt     DateTime    @default(now()) @map("created_at")
  // Null while a send is mid-flight or was stopped partway.
  completedAt   DateTime?   @map("completed_at")

  sends MemberOfferReminderSend[]

  @@map("member_offer_reminders")
}

// One person on a reminder's list. The whole list is written when the reminder
// is claimed - who had not used their code, as Stripe had it at that moment -
// so the batches that follow never ask Stripe anything, and the count shown
// before sending is the list that is mailed.
model MemberOfferReminderSend {
  id         String              @id @default(cuid())
  reminderId String              @map("reminder_id")
  reminder   MemberOfferReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId     String              @map("user_id")
  // As it was when the list was made, for the admin's record.
  email      String
  // Their own code from the offer: the email shows it and its link carries it.
  code       String
  // "bundle" | "fltr" - which of the two emails they are down for.
  variant    String
  sentAt     DateTime?           @map("sent_at")
  // The last send that failed. Cleared by a later success.
  failedAt   DateTime?           @map("failed_at")
  // Dropped at send time: they bought fltr, or stopped taking email, after the
  // list was made. Never mailed, and not tried again.
  skippedAt  DateTime?           @map("skipped_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([reminderId, userId])
  @@index([reminderId, sentAt])
  @@map("member_offer_reminder_sends")
}

model Channel {
  id          String   @id @default(cuid())
  channelId   String   @unique @map("channel_id")
  name        String
  reputation  Float    @default(0.5) // 0.0 = bad, 1.0 = good
  sampleCount Int      @default(0) @map("sample_count")
  skipCount   Int      @default(0) @map("skip_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  samples Sample[]

  @@map("channels")
}

model Sample {
  id                String       @id @default(cuid())
  youtubeId         String       @unique @map("youtube_id")
  title             String
  channel           String
  channelId         String?      @map("channel_id")
  thumbnailUrl      String       @map("thumbnail_url")
  genre             String?
  era               String?
  bpm               Int?         @map("bpm")
  key               String?      @map("key")
  analysisStatus    String?      @default("pending") @map("analysis_status")
  duration          Int?         @map("duration_seconds")
  qualityScore      Float?       @map("quality_score")
  source            String? // "search" | "playlist" | "channel"
  tags              String? // e.g. "post-5.5k"; "drum-break-curated" (PDF drum breaks)
  breakStartSeconds Int?         @map("break_start_seconds") // curated PDF: seconds to drum break; Dig seeks here when set
  embeddable        Boolean?     @map("embeddable") // false = blocked on external sites
  dateAddedDb       DateTime?    @map("date_added_db") // when added from YouTube API (for batch delete)
  createdAt         DateTime     @default(now()) @map("created_at")
  userSamples       UserSample[]
  channelRel        Channel?     @relation(fields: [channelId], references: [id])

  @@map("samples")
}

model Candidate {
  id           String    @id @default(cuid())
  youtubeId    String    @unique @map("youtube_id")
  source       String // "playlist" | "channel" | "manual"
  sourceId     String?   @map("source_id") // playlist ID or channel ID
  addedAt      DateTime  @default(now()) @map("added_at")
  title        String?
  description  String?   @db.Text
  channelId    String?   @map("channel_id")
  channelTitle String?   @map("channel_title")
  thumbnailUrl String?   @map("thumbnail_url")
  duration     Int?      @map("duration_seconds")
  tags         String?   @db.Text // JSON array as string
  publishedAt  DateTime? @map("published_at")
  enrichedAt   DateTime? @map("enriched_at")
  qualityScore Float?    @map("quality_score")
  genre        String?
  era          String?
  embeddable   Boolean?  @map("embeddable") // false = uploader disabled embedding
  processedAt  DateTime? @map("processed_at")
  sampleId     String?   @map("sample_id") // set when promoted to Sample
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("candidates")
}

model UserSample {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  sampleId  String   @map("sample_id")
  startTime Int?     @map("start_time")
  notes     String? // Chop points stored as JSON: [{ key, time, color, index }]
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([userId, sampleId])
  @@map("user_samples")
}

// Persisted dig history for Pro users (up to 1000 rows per user, enforced at API level)
model UserDigHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  youtubeId    String   @map("youtube_id")
  title        String
  channel      String
  thumbnailUrl String   @map("thumbnail_url")
  genre        String?
  bpm          Int?
  key          String?
  viewedAt     DateTime @default(now()) @map("viewed_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, youtubeId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("user_dig_history")
}

model PrelaunchSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("prelaunch_signups")
}

model UserEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_events")
}

// --- creator program (invite-only) ------------------------------------------

model Affiliate {
  id                   String              @id @default(cuid())
  code                 String              @unique
  name                 String
  email                String
  commissionPercent    Int                 @default(30) @map("commission_percent")
  // "percent" (uses commissionPercent) | "flat" (uses commissionFlatCents per sale)
  commissionType       String              @default("percent") @map("commission_type")
  commissionFlatCents  Int?                @map("commission_flat_cents")
  dashboardToken       String              @unique @map("dashboard_token")
  // Stripe Connect Express account for instant payouts (US-only in v1).
  stripeAccountId      String?             @unique @map("stripe_account_id")
  stripePayoutsEnabled Boolean             @default(false) @map("stripe_payouts_enabled")
  userId               String?             @unique @map("user_id")
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  active               Boolean             @default(true)
  notes                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  clicks               AffiliateClick[]
  referrals            AffiliateReferral[]
  payouts              AffiliatePayout[]

  @@map("affiliates")
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

model AffiliateReferral {
  id                       String           @id @default(cuid())
  affiliateId              String           @map("affiliate_id")
  affiliate                Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  purchaseId               String           @unique @map("purchase_id")
  purchase                 Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stripeSessionId          String           @map("stripe_session_id")
  stripePaymentIntentId    String?          @map("stripe_payment_intent_id")
  grossAmountCents         Int              @map("gross_amount_cents")
  // Snapshot at sale time — later rate changes never rewrite history.
  commissionCents          Int              @map("commission_cents")
  currency                 String
  source                   String // "link" (cookie) | "code" (typed at checkout)
  // What this sale was for: "shft" | "drft" | "bundle". Snapshot at sale time,
  // like commissionCents — the purchase row can't answer this, because a bundle
  // referral hangs off the shft purchase to keep the relation one-to-one.
  product                  String           @default("shft")
  // Instant payout bookkeeping: transfer sent at sale, reversal on refund.
  stripeTransferId         String?          @unique @map("stripe_transfer_id")
  stripeTransferReversalId String?          @map("stripe_transfer_reversal_id")
  refundedAt               DateTime?        @map("refunded_at")
  payoutId                 String?          @map("payout_id")
  payout                   AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt                DateTime         @default(now()) @map("created_at")

  @@index([affiliateId, createdAt])
  @@index([stripePaymentIntentId])
  @@map("affiliate_referrals")
}

// --- traffic attribution -----------------------------------------------------

// First-touch attribution for every new visitor. No PII — the visitorId is a
// random UUID mirrored in the httpOnly sr_vid cookie, never an account id.
model LandingEvent {
  id           String   @id @default(cuid())
  visitorId    String   @unique @map("visitor_id")
  referrer     String?
  referrerHost String?  @map("referrer_host")
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  utmContent   String?  @map("utm_content")
  utmTerm      String?  @map("utm_term")
  landingPath  String   @map("landing_path")
  country      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([referrerHost, createdAt])
  @@map("landing_events")
}

model AffiliatePayout {
  id          String              @id @default(cuid())
  affiliateId String              @map("affiliate_id")
  affiliate   Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountCents Int                 @map("amount_cents")
  note        String?
  paidAt      DateTime            @default(now()) @map("paid_at")
  referrals   AffiliateReferral[]

  @@map("affiliate_payouts")
}
