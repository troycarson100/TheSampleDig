# Database
DATABASE_URL="postgresql://user:password@localhost:5432/thesampledig?schema=public"

# NextAuth (required in production for login)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# In production set NEXTAUTH_URL to your app URL, e.g. https://sampleroll.com

# Email (for password reset and email verification)
# Uses Gmail SMTP with an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="you@gmail.com"
# Base URL used in email links (defaults to NEXTAUTH_URL if not set)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETPLACE_ENABLED="false"
# Meta (Facebook) Pixel ID. Leave blank to disable — the pixel loads nothing until set.
NEXT_PUBLIC_META_PIXEL_ID=""

# YouTube
YOUTUBE_API_KEY="your-youtube-api-key"
# Use Playwright to scrape search results instead of Search API (saves quota). Video details still use API. Pagination not supported.
# USE_YOUTUBE_SCRAPER=true

# Spotify (for BPM/key backfill – no YouTube audio; see scripts/backfill-bpm-key.ts)
# Create an app at https://developer.spotify.com/dashboard. Note: New apps after Nov 2024 may not get Audio Features access.
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"

# Google Custom Search (optional fallback for BPM/key when Spotify has no match)
# Create at https://programmablesearchengine.google.com/ and enable Custom Search API in Cloud Console. 100 free queries/day.
# GOOGLE_CSE_API_KEY="your-google-api-key"
# GOOGLE_CSE_ID="your-search-engine-id"

# Stripe (Pro subscriptions) – get from https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# shft plugin (one-time purchase). Checkout is dormant until the price id is set.
STRIPE_SHFT_PRICE_ID="price_..."

# drft plugin (one-time purchase). Checkout is dormant until the price id is set.
STRIPE_DRFT_PRICE_ID="price_..."

# Bundle (shft + drft together, one-time purchase).
STRIPE_BUNDLE_PRICE_ID="price_..."

# Crossgrade prices: the discounted price shown to someone who already owns the
# other plugin. If a crossgrade var is unset, the UI correctly falls back to
# showing (and charging) the full price — it never advertises a price that
# can't actually be charged.
STRIPE_DRFT_CROSSGRADE_PRICE_ID="price_..."
STRIPE_SHFT_CROSSGRADE_PRICE_ID="price_..."

# Comma-separated emails allowed into /admin (affiliate management)
ADMIN_EMAILS=""

# Paid-download storage (S3-compatible: DigitalOcean Spaces or Supabase Storage).
# The /products page serves short-lived signed URLs for owned assets from here.
# One bucket for the whole site - objects are namespaced by product key prefix
# (shft/..., drft/...), not by separate per-product buckets.
SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
SPACES_REGION="nyc3"
SPACES_BUCKET="shftdownload"
SPACES_KEY="..."
SPACES_SECRET="..."
# Optional: object keys for the current shft release (default to shft/<filename>).
# Bump these when you ship a new version.
# SHFT_INSTALLER_KEY="shft/shft-1.0.11.pkg"
# SHFT_MANUAL_KEY="shft/shft-manual-v1.3.pdf"
# Optional: object keys for the current drft release (default to drft/<filename>).
# DRFT_INSTALLER_KEY="drft/drft-1.0.0.pkg"
# DRFT_INSTALLER_WIN_KEY="drft/drft-1.0.0-setup.exe"
# DRFT_MANUAL_KEY="drft/drft-manual-v1.0.pdf"

# Landing page mockup video (optional). If set, used for the Sneak Peek browser mockup.
# Otherwise the app looks for public/prelaunch/dig-browser-recording.mp4 (add an MP4 for deployment).
# NEXT_PUBLIC_PRELAUNCH_VIDEO_URL="https://your-cdn.com/dig-preview.mp4"

# Secret page: test BPM/key analysis by uploading audio. If set, only /internal/audio-test?secret=YOUR_SECRET works.
# AUDIO_TEST_SECRET="your-secret-string"
