# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# temporary audio files
/tmp

# stem splitter output (uploaded files + separated stems)
.stem-output
.venv-stem

# populate resume state (local only)
.populate-resume-state.json
.populate-drum-breaks-500-state.json
# daily backfill logs
/logs

# prelaunch/dig reference video (large; add locally or host elsewhere)
dig-browser-recording.mov
public/prelaunch/dig-browser-recording.mov

# DB backups (contain data; keep local or store elsewhere)
/backups

# iCloud evicts the tens of thousands of small files in node_modules/.next into
# placeholders it then won't fault back, which hangs `next dev` inside require()
# at 0% CPU. iCloud refuses to sync anything named *.nosync, so both live there
# and are symlinked back into place.
node_modules.nosync
.next.nosync
# Both are symlinks now, so the existing `/.next/` rule (directories only) misses it.
/.next

# Screenshots from scripts/verify-shft-social.mjs
reports/shft-social/

# Script progress/state files
.populate-acapella-250-state.json

# Scratch workspace for subagent-driven-development plan execution
.superpowers/

# Isolated worktrees for agent-driven feature work. Named *.nosync like
# node_modules.nosync/.next.nosync above: a worktree checkout writes a full
# copy of the tracked tree, and doing that inside plain .worktrees/ (still
# under iCloud-synced ~/Documents) hung indefinitely on the very first file
# write - iCloud won't sync anything named *.nosync, so this location is left
# alone entirely.
.worktrees.nosync/

# drft A/B masters. The 24-bit OFF/ON pairs are ~33MB; only the MP3s that
# scripts/build-drft-ab-peaks.mjs derives from them ever get committed.
/public/drft/ab/_src/
